# English Center - Docker Environment Variables
# Copy this file to .env and fill in your values

# =========================
# DATABASE (SQL Server)
# =========================
SA_PASSWORD=YourStrong@Passw0rd

# =========================
# JWT AUTHENTICATION
# =========================
# Generate a strong random key (min 32 chars for HS256)
JWT_KEY=your-super-secret-jwt-key-min-32-characters-long
JWT_ISSUER=EnglishCenter
JWT_AUDIENCE=EnglishCenterClient
JWT_REFRESH_TOKEN_DAYS=30

# =========================
# EMAIL SETTINGS (SMTP)
# =========================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=English Center
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENABLE_SSL=true

# =========================
# VNPAY PAYMENT (Optional)
# =========================
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:7300/gateway/v1/Payments/vnpay-return

# =========================
# FRONTEND URL (for CORS)
# =========================
FRONTEND_URL=http://localhost:5500
